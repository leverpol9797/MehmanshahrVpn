<?xml version="1.0" encoding="utf-8"?>
<!--
    The dashboard's theme. Separate from AppTheme rather than a night variant of it, because the
    dashboard and the log terminal carry their own fixed palette and the older settings screens
    carry the light one. Letting the system flip between them per screen would be a different
    design decision than either screen makes on purpose.

    Status and navigation bars are painted the app background so the screen has no light seam at
    the top or bottom, and windowLightStatusBar is off for the same reason.
-->
<resources>
    <style name="DashboardTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/app_accent</item>
        <item name="colorOnPrimary">@color/app_text</item>
        <item name="colorPrimaryContainer">@color/app_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/app_text</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_raised</item>
        <item name="colorOutline">@color/app_border</item>
        <item name="colorOnSurface">@color/app_text</item>
        <item name="colorOnSurfaceVariant">@color/app_text_muted</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>