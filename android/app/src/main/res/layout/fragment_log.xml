<?xml version="1.0" encoding="utf-8"?>
<!--
    The log terminal. A plain vertical list rather than a nested scroll view: the log is
    appended to far more often than it is read, and a ScrollView inside a scrolling page
    makes the outer scroll fight the inner one.

    The filter row sits above the list as a horizontal chip group. Each chip toggles one
    level; when every chip is on, the view shows everything.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/logRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_sunken">

    <LinearLayout
        android:id="@+id/logToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@color/surface">

        <TextView
            android:id="@+id/logTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_terminal"
            android:textColor="@color/app_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logFollowToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="@drawable/filter_chip_background"
            android:text="@string/log_follow"
            android:textColor="@color/app_accent"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/logCopyButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/log_copy"
            android:src="@drawable/ic_copy"
            app:tint="@color/app_text_muted" />

        <ImageButton
            android:id="@+id/logClearButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/log_clear"
            android:src="@drawable/ic_clear"
            app:tint="@color/app_text_muted" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/logFilterChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="false"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="false" />
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/app_border" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/logList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/logEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/log_empty"
            android:textColor="@color/app_text_faint"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/logFilteredEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/log_no_matches"
            android:textColor="@color/app_text_faint"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logResetNetworkButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/log_reset_network"
            app:icon="@drawable/ic_refresh"
            app:strokeColor="@color/state_connecting" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logDisconnectButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/log_disconnect"
            app:icon="@drawable/ic_power"
            app:strokeColor="@color/state_error" />
    </LinearLayout>
</LinearLayout>