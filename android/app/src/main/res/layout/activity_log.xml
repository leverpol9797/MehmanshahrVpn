<?xml version="1.0" encoding="utf-8"?>
<!--
    The log screen. A wrapper rather than a second copy of the terminal markup, so the terminal
    is defined in one place and this screen is only "and it fills the window".

    The close button floats over the terminal's own toolbar rather than sitting beside it: giving
    the toolbar a slot would mean the terminal had to know whether it was hosted or standalone.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/logRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_sunken">

    <include
        android:id="@+id/logTerminalHost"
        layout="@layout/fragment_log" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/logClose"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:contentDescription="@string/log_close"
        app:icon="@drawable/ic_clear"
        app:iconTint="@color/app_text_muted" />
</FrameLayout>