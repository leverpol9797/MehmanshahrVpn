<!--
  Monochrome variant of the launcher mark: a shield with a keyhole, drawn as
  strokes so a launcher can tint it to match the system theme.

  Used by the themed-icon layer, the quick-settings tile and the navigation
  drawer. Those render it at 24dp rather than the 108dp launcher canvas, so
  the geometry is redrawn at that scale — a 108dp shield shrunk to 24dp loses
  its stroke to rounding.

  Same silhouette as ic_launcher_foreground so the tile and the launcher icon
  read as one mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Shield outline -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineJoin="round"
        android:pathData="M12,2.6L20.2,5.9L20.2,12.3C20.2,15.9,17.3,18.5,12,21.4C6.7,18.5,3.8,15.9,3.8,12.3L3.8,5.9Z" />
    <!-- Keyhole: circle over a tapered slot, filled rather than cut so this
         reads against a tinted background as well as a white one. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,8.2m-1.9,0a1.9,1.9 0,1 0,3.8 0a1.9,1.9 0,1 0,-3.8 0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.2,9.7L12.8,9.7L13.3,13.6L10.7,13.6Z" />
</vector>
