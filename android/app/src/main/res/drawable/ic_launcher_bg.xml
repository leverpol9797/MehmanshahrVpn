<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher background. A flat fill made the shield read as a sticker; the
  diagonal gradient gives it depth at every density without shipping a
  rasterised layer.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/hero_start"
        android:centerColor="@color/hero_center"
        android:endColor="@color/hero_end"
        android:type="linear" />
</shape>
